---
/**
 * 3D viewer island. The poster/placeholder paints instantly as static HTML;
 * the Three.js viewer chunk is then lazy-imported and replaces the poster once
 * the model is ready, auto-rotating until the visitor grabs it.
 *
 * Construction is driven from one place — the bootstrap script in
 * ProjectOverlay.astro — rather than a script here, so that the page can hold
 * on to each viewer's handle and suspend it while something else is on screen.
 */
interface Axis {
  id: string;
  label: string;
  pivot: [number, number, number];
  axis: [number, number, number];
  range: [number, number];
  start: number;
  parent?: string;
  include: string[];
  exclude: string[];
}

interface Props {
  src: string;
  poster?: string;
  alt?: string;
  /** CAD exports are usually Z-up; glTF is Y-up. Set "z" to stand the model upright. */
  up?: "y" | "z";
  /** Movable joints — rendered as sliders and reconstructed by the viewer. */
  axes?: Axis[];
  /** Stretch to fill its container instead of holding a fixed aspect ratio. */
  fill?: boolean;
  /** Skip automatic construction; the page decides when this viewer starts. */
  manual?: boolean;
}

const {
  src,
  poster,
  alt = "3D model preview",
  up = "y",
  axes = [],
  fill = false,
  manual = false,
} = Astro.props;

const shape = fill
  ? "aspect-[4/3] w-full sm:aspect-[16/10] lg:aspect-auto lg:h-full"
  : "aspect-[4/3] w-full sm:aspect-[16/9]";
---

<div
  class:list={[
    "model-viewer group relative overflow-hidden rounded-xl bg-card ring-1 ring-foreground/10 select-none",
    shape,
  ]}
  data-model-src={src}
  data-up={up}
  data-axes={axes.length > 0 ? JSON.stringify(axes) : undefined}
  data-viewer-manual={manual ? "" : undefined}
>
  <div data-viewer-poster class="absolute inset-0">
    {
      poster ? (
        <img src={poster} alt={alt} class="h-full w-full object-cover" decoding="async" />
      ) : (
        <div
          aria-hidden="true"
          class="h-full w-full [background-image:linear-gradient(to_right,--theme(--color-border/40%)_1px,transparent_1px),linear-gradient(to_bottom,--theme(--color-border/40%)_1px,transparent_1px)] [background-size:32px_32px]"
        />
      )
    }
  </div>

  <div
    data-viewer-progress
    hidden
    class="absolute inset-x-0 bottom-0 z-10 p-3 text-center text-xs text-muted-foreground"
  >
    <div class="mx-auto h-1 w-2/3 overflow-hidden rounded-full bg-muted">
      <div
        data-viewer-progress-bar
        class="h-full w-0 rounded-full bg-foreground/70 transition-[width] duration-200"
      >
      </div>
    </div>
  </div>

  {
    axes.length > 0 && (
      <div
        data-viewer-axes
        hidden
        class="absolute top-2 left-2 z-10 w-40 rounded-md border border-border bg-background/80 p-2.5 backdrop-blur sm:w-48"
      >
        <p class="mb-2 text-[10px] font-medium tracking-wider text-muted-foreground uppercase">
          Axes
        </p>
        {axes.map((axis) => (
          <label class="mt-2.5 block first:mt-0">
            <span class="flex items-baseline justify-between gap-2 text-xs">
              <span class="font-medium">{axis.label}</span>
              <span data-axis-value={axis.id} class="text-muted-foreground tabular-nums">
                {axis.start}°
              </span>
            </span>
            <input
              type="range"
              data-axis={axis.id}
              min={axis.range[0]}
              max={axis.range[1]}
              value={axis.start}
              step="1"
              aria-label={axis.label}
              class="mt-1.5 w-full accent-foreground"
            />
          </label>
        ))}
      </div>
    )
  }

</div>
